# Express API (../backend). The app seeds PostgreSQL from here when the database is empty.
VITE_API_BASE_URL=http://localhost:8000/api

# Backend proxy endpoint for AI calls. NEVER put provider API keys in VITE_* vars:
# anything prefixed VITE_ is bundled into the browser.
VITE_AI_PROXY_URL=http://localhost:8000/api/ai
